extends RefCounted

const FRAME_SIZE := 64
const COLS := 8
const ROWS := 4
const PNG_B64 := ""

static func build_texture() -> Texture2D:
	var raw: PackedByteArray = Marshalls.base64_to_raw(PNG_B64)
	var image := Image.new()
	var err := image.load_png_from_buffer(raw)
	if err != OK:
		push_error("Falha ao decodificar sprite atlas 0.5.9: %s" % err)
		return null
	return ImageTexture.create_from_image(image)

static func frame(atlas: Texture2D, col: int, row: int) -> Texture2D:
	var tex := AtlasTexture.new()
	tex.atlas = atlas
	tex.region = Rect2(col * FRAME_SIZE, row * FRAME_SIZE, FRAME_SIZE, FRAME_SIZE)
	return tex
